{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Handy",
  "version": "0.9.8",
  "identifier": "com.pais.handy",
  "build": {
    "beforeDevCommand": "bun scripts/macos-build-layout.ts && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun scripts/macos-build-layout.ts && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "requireLiteralLeadingDot": true
        }
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost http://localhost:1420 ws://localhost:1421 ws://localhost:1420",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": ["resources/**/*"],
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {},
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": ["libgtk-layer-shell0", "libopenblas0"],
        "files": {
          "/usr/lib/Handy": "transcribe-libs"
        }
      },
      "rpm": {
        "depends": [
          "libgtk-layer-shell.so.0()(64bit)",
          "libopenblas.so.0()(64bit)"
        ],
        "compression": {
          "type": "none"
        },
        "files": {
          "/usr/lib/Handy": "transcribe-libs"
        }
      },
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/lib": "transcribe-libs"
        }
      }
    },
    "windows": {
      "signCommand": "trusted-signing-cli -e https://eus.codesigning.azure.net/ -a CJ-Signing -c cjpais-dev -d Handy %1",
      "nsis": {
        "template": "nsis/installer.nsi",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBQjcyMDk1MjA2NjAxRjkKUldUNUFXWWdsU0MzdXRRZi8zYzhqV2FaNUVDbDd2Rk5VM1IvWWowVXdmRFNKQ1BrMXF5RFFsLy8K",
      "endpoints": [
        "https://github.com/cjpais/Handy/releases/latest/download/latest.json"
      ]
    }
  }
}
