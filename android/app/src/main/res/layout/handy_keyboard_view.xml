<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#2C2B29"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="14dp">

    <!-- Top status & quick controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ime_engine_chip"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_ime_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Whisper"
            android:textColor="#FBFBFB"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ime_lang_chip"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_ime_key"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Auto"
            android:textColor="#FBFBFB"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ime_ai_chip"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_ime_key"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/ime_ai_off"
            android:textColor="#D4D4D4"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/ime_open_app"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_ime_key"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Handy ↗"
            android:textColor="#FAA2CA"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Status / Partial preview -->
    <TextView
        android:id="@+id/ime_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:minHeight="22dp"
        android:text="@string/ime_tap_to_speak"
        android:textColor="#E4E4E7"
        android:textSize="13sp" />

    <!-- Primary Voice Button + Cancel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/ime_cancel_btn"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_ime_key"
            android:minWidth="68dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/ime_cancel"
            android:textAllCaps="false"
            android:textColor="#F87171"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/ime_mic_btn"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ime_mic_idle"
            android:text="@string/ime_tap_to_speak"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Utility Key Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/ime_switch_btn"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_ime_key"
            android:text="🌐"
            android:textSize="16sp" />

        <Button
            android:id="@+id/ime_space_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ime_key"
            android:text="@string/ime_space"
            android:textAllCaps="false"
            android:textColor="#FBFBFB"
            android:textSize="13sp" />

        <Button
            android:id="@+id/ime_backspace_btn"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_ime_key"
            android:text="⌫"
            android:textColor="#FBFBFB"
            android:textSize="16sp" />

        <Button
            android:id="@+id/ime_enter_btn"
            android:layout_width="68dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_ime_key"
            android:text="↵"
            android:textColor="#FAA2CA"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
